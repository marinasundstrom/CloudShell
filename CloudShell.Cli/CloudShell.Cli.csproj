<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cloudshell</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>cloudshell</ToolCommandName>
    <PackageId>CloudShell.Cli</PackageId>
    <CloudShellBuiltInServiceRuntime Condition="'$(CloudShellBuiltInServiceRuntime)' == ''">Container</CloudShellBuiltInServiceRuntime>
    <BundledDevelopmentHostPublishDirectory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'bundled-development-host', '$(Configuration)'))/</BundledDevelopmentHostPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudShell.Abstractions\CloudShell.Abstractions.csproj" />
    <ProjectReference Include="..\CloudShell.Client\CloudShell.Client.csproj" />
    <ProjectReference Include="..\CloudShell.ControlPlane.Client\CloudShell.ControlPlane.Client.csproj" />
    <ProjectReference Include="..\CloudShell.ResourceModel\CloudShell.ResourceModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.1" />
  </ItemGroup>

  <Target Name="BundleDevelopmentHost"
          BeforeTargets="PackTool">
    <RemoveDir Directories="$(BundledDevelopmentHostPublishDirectory)" />
    <RemoveDir Directories="$(PublishDir)host" />
    <MSBuild Projects="$(MSBuildProjectDirectory)/../CloudShell.LocalDevelopmentHost/CloudShell.LocalDevelopmentHost.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);PublishDir=$(BundledDevelopmentHostPublishDirectory);UseAppHost=false;Version=$(Version);PackageVersion=$(PackageVersion);CloudShellBuiltInServiceRuntime=$(CloudShellBuiltInServiceRuntime)" />
    <ItemGroup>
      <_BundledDevelopmentHostFile Include="$(BundledDevelopmentHostPublishDirectory)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_BundledDevelopmentHostFile)"
          DestinationFiles="@(_BundledDevelopmentHostFile->'$(PublishDir)host/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
