<CodeEditor @ref="Editor" Label="@Label" Language="json" InitialValue="@InitialValue" ReadOnly="@ReadOnly" />

@code {
    [Parameter] public string Label { get; set; } = "JSON";
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string InitialValue { get; set; } = "{}";
    private CodeEditor? Editor;
    public Task<string> GetValueAsync() => Editor?.GetValueAsync() ?? Task.FromResult(InitialValue);
}
