@inject IStringLocalizer<SharedResource> L
@{ var nodes = Nodes; }
<p class="graph-caption">@L["Declared relationships · lifecycle updates every 5 seconds"]</p>
@if (nodes.Count > 0)
{
    <ResourceRelationshipDiagram Resources="nodes" GetLabel="Context.GetLabel" SelectedResourceId="Context.ResourceId" />
}
<p class="graph-caption">@L["Solid: dependency · dashed: parent · dotted: owner. These are declared relationships, not observed traffic."]</p>
@if (Context.Resources.Count > 24 && Context.IsSystem) { <p>@L["Showing the first 24 resources. Select a resource to inspect its neighborhood."]</p> }
@if (nodes.Count == 0) { <p>@L["No visible relationships."]</p> }
<FluentAnchor Href="@ResourceManagerRoutes.ResourceGraph">@L["Open full graph"]</FluentAnchor>
@code {
    [CascadingParameter] public OperationsWorkspaceContext Context { get; set; } = default!;
    private IReadOnlyList<Resource> Nodes => (Context.Resource is not { } selected ? Context.Resources : Context.Resources.Where(r => r.Id == selected.Id || selected.DependsOn.Contains(r.Id) || r.DependsOn.Contains(selected.Id) || r.ParentResourceId == selected.Id || selected.ParentResourceId == r.Id || r.OwnerResourceId == selected.Id || selected.OwnerResourceId == r.Id)).OrderBy(r => r.Id == Context.ResourceId ? 0 : 1).ThenBy(r => r.Id, StringComparer.Ordinal).Take(24).ToArray();
}
