@inject IResourceManager Manager
@inject IOptions<ResourceManagerUiOptions> Options
@inject IStringLocalizer<SharedResource> L
<div class="quick-actions">
@foreach (var action in Resource.ResourceActions.Where(a => a.Kind != ResourceActionKind.Custom))
{
    var control = ResourceActionControlStateResolver.Resolve(action, Capabilities, Options.Value.ReadOnly, Workspace?.IsActionExecuting(Resource.Id, action.Id) == true, L["Working…"].Value);
    <FluentButton Disabled="@(!control.IsEnabled || Workspace?.RequestActionAsync is null)" Title="@control.Title" IconStart="@OperationsActionIcons.From(action.EffectivePresentation.Icon)" OnClick="() => RequestAsync(action)">@L[action.DisplayName]</FluentButton>
}
</div>
@code {
    [Parameter, EditorRequired] public Resource Resource { get; set; } = default!;
    private ResourceOperationCapabilities Capabilities = ResourceOperationCapabilities.None("");
    [CascadingParameter] public OperationsWorkspaceContext? Workspace { get; set; }
    protected override async Task OnParametersSetAsync()
    {
        try { Capabilities = (await Manager.GetResourceOperationCapabilitiesAsync([Resource.Id])).GetValueOrDefault(Resource.Id) ?? ResourceOperationCapabilities.None(Resource.Id); }
        catch (Exception) { Capabilities = ResourceOperationCapabilities.None(Resource.Id); }
    }
    private Task RequestAsync(ResourceAction action) =>
        Workspace?.RequestActionAsync?.Invoke(Resource, action) ?? Task.CompletedTask;
}
