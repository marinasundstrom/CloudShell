@page "/Error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Http
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Error"]</PageTitle>

<PageHeading Title="@L["Something went wrong"].Value"
             Description="@L["CloudShell could not complete this request."].Value" />
<ShellPanel>
    <p>@L["Try opening the page again. If the problem continues, share the request ID with your administrator."]</p>
    @if (ShowRequestId)
    {
        <p><strong>@L["Request ID:"]</strong> <code>@RequestId</code></p>
    }
    <FluentAnchor Href="/resources" Appearance="Appearance.Accent">@L["Open Resources"]</FluentAnchor>
</ShellPanel>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
