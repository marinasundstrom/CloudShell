@page "/"
@rendermode InteractiveServer
@inject ShellCatalog ShellCatalog
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized() => Navigation.NavigateTo(
        !string.IsNullOrWhiteSpace(ShellCatalog.StartRoute) && ShellCatalog.StartRoute != "/"
            ? ShellCatalog.StartRoute : "/resources?operation=dashboard", replace: true);
}
