@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Page not found"]</PageTitle>
<PageHeading Title="@L["Page not found"].Value"
             Description="@L["The page may have moved or no longer exists."].Value" />
<ShellPanel>
    <EmptyState Title="@L["Choose another page"].Value"
                Message="@L["Use the navigation or return to Resources to continue."].Value">
        <FluentAnchor Href="/resources" Appearance="Appearance.Accent">@L["Open Resources"]</FluentAnchor>
    </EmptyState>
</ShellPanel>
