@using System.Text.Json
@inject IResourceManager ResourceManager
@inject NavigationManager Navigation
@inject ICloudShellAuthorizationService Authorization

<ResourceRegistrationWizard TDraft="RegistrationDraft" @ref="Wizard" Steps="WizardSteps" @bind-Draft="Draft" Error="@ErrorMessage" OnCreate="Register" />

@code {
    private ResourceRegistrationWizard<RegistrationDraft> Wizard = default!;
    private RegistrationDraft Draft { get; set; } = new();
    private string? ValidateBasics() => string.IsNullOrWhiteSpace(ResourceId) ? "Name is required." : Draft.Group.Validate();
    private IReadOnlyList<ResourceRegistrationWizardStep> WizardSteps =>
    [
        new("Basics", Step0, ValidateBasics),
        new("DNS provider", Step1, () => string.IsNullOrWhiteSpace(ZoneName) ? "Zone name is required." : null),
        new("Name mapping", Step2, ValidateMappingStep),
        new("Review", Step3),
    ];
    private RenderFragment Step0 => @<FormPanel>
        <ResourceIdentityFields ResourceIdInputId="dns-zone-resource-id"
                                ResourceIdPlaceholder="cloudshell-local"
                                @bind-ResourceId="ResourceId" />
        <ResourceRegistrationGroupSelect Draft="Draft.Group" AllowNewGroup="@(Authorization.CanAccessResourceGroup("__new_resource_group", CloudShellPermissions.ResourceGroups.Create))" Id="dns-zone-group"
                             ResourceGroups="ResourceGroups"
                             @bind-Value="SelectedGroupId" />
    </FormPanel>;
    private RenderFragment Step1 => @<FormPanel>
        <label for="dns-zone-name-value">Zone name</label>
        <FluentTextField Id="dns-zone-name-value" @bind-Value="ZoneName" Placeholder="cloudshell.local" />

        <label for="dns-zone-provider">DNS provider</label>
        <FluentSelect TOption="string"
                      Id="dns-zone-provider"
                      @bind-Value="ProviderSelection"
                      Appearance="Appearance.Outline">
            <FluentOption TOption="string" Value="@LogicalProviderSelection">Logical only</FluentOption>
            <FluentOption TOption="string" Value="@LocalHostNamesProvider">Local host names</FluentOption>
            <FluentOption TOption="string" Value="@CustomProviderSelection">Custom provider ID</FluentOption>
        </FluentSelect>

        @if (IsCustomProviderSelected)
        {
            <label for="dns-zone-custom-provider">Custom DNS provider ID</label>
            <FluentTextField Id="dns-zone-custom-provider" @bind-Value="Provider" Placeholder="provider-id" />
        }

        @if (IsLocalHostNameProviderSelected)
        {
            <ResourceCallout Severity="ResourceSignalSeverity.Info"
                             Title="Local host-name publishing"
                             Role="status">
                <span>Local host-name publishing writes exact host mappings to the configured hosts-file target when name mappings are reconciled.</span>
            </ResourceCallout>
        }

        @if (ShouldWarnAboutLocalSuffix(ZoneName) || (CreateNameMapping && ShouldWarnAboutLocalSuffix(HostName)))
        {
            <ResourceCallout Severity="ResourceSignalSeverity.Warning"
                             Title="Local suffix warning"
                             Role="alert">
                <span>Names ending in .local may conflict with mDNS/Bonjour on the host network. Use them intentionally for local development and reconcile them only on hosts where this suffix is acceptable.</span>
            </ResourceCallout>
        }
    </FormPanel>;
    private RenderFragment Step2 => @<FormPanel>
        <ResourceEditorSection Title="Initial name mapping">
            <FluentCheckbox @bind-Value="CreateNameMapping">
                Add name mapping
            </FluentCheckbox>

            @if (CreateNameMapping)
            {
                <label for="dns-mapping-host">Host name</label>
                <FluentTextField Id="dns-mapping-host" @bind-Value="HostName" Placeholder="app.cloudshell.local" />

                <label for="dns-mapping-target">Target resource</label>
                <FluentSelect TOption="string"
                              Id="dns-mapping-target"
                              @bind-Value="TargetResourceId"
                              Appearance="Appearance.Outline">
                    <FluentOption TOption="string" Value="">Select a target</FluentOption>
                    @foreach (var target in GetTargetCandidates())
                    {
                        <FluentOption TOption="string" Value="@target.Id">@ResourceDisplayLabels.GetQualifiedLabel(target)</FluentOption>
                    }
                </FluentSelect>

                @if (GetTargetEndpoints(TargetResourceId).Count > 0)
                {
                    <label for="dns-mapping-target-endpoint">Target endpoint</label>
                    <FluentSelect TOption="string"
                                  Id="dns-mapping-target-endpoint"
                                  @bind-Value="TargetEndpointName"
                                  Appearance="Appearance.Outline">
                        <FluentOption TOption="string" Value="">Any endpoint</FluentOption>
                        @foreach (var endpoint in GetTargetEndpoints(TargetResourceId))
                        {
                            <FluentOption TOption="string" Value="@endpoint.Name">@endpoint.Name</FluentOption>
                        }
                    </FluentSelect>
                }

                <EnumValueSelect TEnum="ResourceExposureScope"
                                 Id="dns-mapping-exposure"
                                 Label="Exposure"
                                 @bind-Value="SelectedExposure" />

                <label for="dns-mapping-provider">Publishing provider resource</label>
                <FluentSelect TOption="string"
                              Id="dns-mapping-provider"
                              @bind-Value="ProviderResourceId"
                              Appearance="Appearance.Outline">
                    <FluentOption TOption="string" Value="">Use zone provider</FluentOption>
                    @foreach (var provider in GetNamePublisherCandidates())
                    {
                        <FluentOption TOption="string" Value="@provider.Id">@ResourceDisplayLabels.GetQualifiedLabel(provider)</FluentOption>
                    }
                </FluentSelect>
            }
        </ResourceEditorSection>
    </FormPanel>;
    private RenderFragment Step3 => @<FormPanel>
        <dl class="registration-review">
            <dt>Name</dt><dd>@ResourceId</dd>
            <dt>Resource group</dt><dd>@(Draft.Group.CreateNew ? $"New group: {Draft.Group.Name}" : ResourceGroups.FirstOrDefault(group => group.Id == SelectedGroupId)?.Name ?? Draft.Group.CreatedGroupName ?? "Default group")</dd>
            <dt>Zone</dt><dd>@ZoneName</dd>
            <dt>Host name</dt><dd>@HostName</dd>
            <dt>Provider</dt><dd>@Provider</dd>
            <dt>Target</dt><dd>@TargetResourceId</dd>
        </dl>
        <p class="muted">Review your choices before creating the resource. Use Back to make changes.</p>
    </FormPanel>;

    public sealed class RegistrationDraft
    {
        public ResourceRegistrationGroupDraft Group { get; set; } = new();
        public string ResourceId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string ZoneName { get; set; } = string.Empty;
        public string Provider { get; set; } = string.Empty;
        public string ProviderSelection { get; set; } = LogicalProviderSelection;
        public string SelectedGroupId { get; set; } = string.Empty;
        public bool CreateNameMapping { get; set; } = true;
        public string HostName { get; set; } = string.Empty;
        public string TargetResourceId { get; set; } = string.Empty;
        public string TargetEndpointName { get; set; } = string.Empty;
        public string SelectedExposure { get; set; } = ResourceExposureScope.Public.ToString();
        public string ProviderResourceId { get; set; } = string.Empty;
    }

    private const string PlatformProviderId = "cloudshell.platform";
    private const string DnsZoneResourceType = "cloudshell.dnsZone";
    private const string NetworkResourceType = "cloudshell.network";
    private const string VirtualNetworkResourceType = "cloudshell.virtualNetwork";
    private const string NameMappingType = "cloudshell.nameMapping";
    private const string LogicalProviderSelection = "";
    private const string LocalHostNamesProvider = "local-hostnames";
    private const string CustomProviderSelection = "__custom";

    private string ResourceId { get => Draft.ResourceId; set => Draft.ResourceId = value; }
    private string Name { get => Draft.Name; set => Draft.Name = value; }
    private string ZoneName { get => Draft.ZoneName; set => Draft.ZoneName = value; }
    private string Provider { get => Draft.Provider; set => Draft.Provider = value; }
    private string ProviderSelection { get => Draft.ProviderSelection; set => Draft.ProviderSelection = value; }
    private string SelectedGroupId { get => Draft.SelectedGroupId; set => Draft.SelectedGroupId = value; }
    private bool CreateNameMapping { get => Draft.CreateNameMapping; set => Draft.CreateNameMapping = value; }
    private string HostName { get => Draft.HostName; set => Draft.HostName = value; }
    private string TargetResourceId { get => Draft.TargetResourceId; set => Draft.TargetResourceId = value; }
    private string TargetEndpointName { get => Draft.TargetEndpointName; set => Draft.TargetEndpointName = value; }
    private string SelectedExposure { get => Draft.SelectedExposure; set => Draft.SelectedExposure = value; }
    private string ProviderResourceId { get => Draft.ProviderResourceId; set => Draft.ProviderResourceId = value; }
    private string? ErrorMessage { get; set; }
    private IReadOnlyList<ResourceGroup> ResourceGroups { get; set; } = [];
    private IReadOnlyList<Resource> Resources { get; set; } = [];
    private IReadOnlyDictionary<string, ResourceGroup> ResourceGroupsByResourceId { get; set; } =
        ResourceManagerUiAccess.EmptyGroupLookup;

    [CascadingParameter]
    public ResourceRegistrationNavigationContext? RegistrationNavigation { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ResourceGroups = await ResourceManager.ListResourceGroupsAsync();
        Resources = await ResourceManager.ListResourcesAsync();
        ResourceGroupsByResourceId = await ResourceManagerUiAccess.CreateGroupLookupAsync(
            ResourceManager,
            Resources);

    }

    private IReadOnlyList<Resource> GetTargetCandidates() =>
        Resources
            .Where(resource => !IsDnsResource(resource))
            .Where(resource => !IsNetworkBoundaryResource(resource))
            .Where(resource => resource.Endpoints.Count > 0 || resource.HasCapability(ResourceCapabilityIds.EndpointSource))
            .Where(IsInSelectedGroup)
            .OrderBy(ResourceDisplayLabels.GetQualifiedLabel, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private IReadOnlyList<Resource> GetNamePublisherCandidates() =>
        Resources
            .Where(resource => resource.HasCapability(ResourceCapabilityIds.NetworkingNamePublisher))
            .Where(IsInSelectedGroup)
            .OrderBy(ResourceDisplayLabels.GetQualifiedLabel, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private IReadOnlyList<ResourceEndpoint> GetTargetEndpoints(string resourceId) =>
        Resources
            .FirstOrDefault(resource => string.Equals(resource.Id, resourceId, StringComparison.OrdinalIgnoreCase))
            ?.Endpoints ?? [];

    private bool IsInSelectedGroup(Resource resource)
    {
        var group = ResourceManagerUiAccess.GetResourceGroup(ResourceGroupsByResourceId, resource.Id);
        return string.IsNullOrWhiteSpace(SelectedGroupId)
            ? group is null
            : string.Equals(group?.Id, SelectedGroupId, StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsNetworkBoundaryResource(Resource resource) =>
        string.Equals(resource.EffectiveTypeId, NetworkResourceType, StringComparison.OrdinalIgnoreCase) ||
        string.Equals(resource.EffectiveTypeId, VirtualNetworkResourceType, StringComparison.OrdinalIgnoreCase);

    private static bool IsDnsResource(Resource resource) =>
        string.Equals(resource.EffectiveTypeId, DnsZoneResourceType, StringComparison.OrdinalIgnoreCase) ||
        string.Equals(resource.EffectiveTypeId, NameMappingType, StringComparison.OrdinalIgnoreCase);

    private string? ValidateMappingStep()
    {
        ErrorMessage = null;
        _ = BuildMappings();
        return ErrorMessage;
    }

    private async Task Register()
    {
        ErrorMessage = null;
        if (string.IsNullOrWhiteSpace(ResourceId))
        {
            ErrorMessage = "Name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(ZoneName))
        {
            ErrorMessage = "Zone name is required.";
            return;
        }

        var mappings = BuildMappings();
        if (ErrorMessage is not null)
        {
            return;
        }

        var normalizedResourceId = ResourceNameNormalizer.Normalize(ResourceId, "dns");
        var displayName = ResourceDisplayNameDefaults.Resolve(ResourceId);
        var definition = new DnsZoneResourceDefinition(
            normalizedResourceId,
            displayName,
            ZoneName,
            GetProvider(),
            mappings);

        SelectedGroupId = await Draft.Group.ResolveAsync(SelectedGroupId,
            command => ResourceManager.CreateResourceGroupAsync(command)) ?? string.Empty;
        await ResourceManager.CreateResourceAsync(
            new CreateResourceCommand(
                PlatformProviderId,
                DnsZoneResourceType,
                normalizedResourceId,
                displayName,
                JsonSerializer.SerializeToElement(definition),
                string.IsNullOrWhiteSpace(SelectedGroupId) ? null : SelectedGroupId));

        await Wizard.CompleteAsync();
        Navigation.NavigateTo(GetReturnUrl());
    }

    private string GetReturnUrl() =>
        RegistrationNavigation?.GetReturnUrlOrDefault() ??
        ResourceRegistrationNavigationContext.DefaultReturnUrl;

    private IReadOnlyList<DnsNameMappingDefinition> BuildMappings()
    {
        if (!CreateNameMapping)
        {
            return [];
        }

        if (string.IsNullOrWhiteSpace(HostName))
        {
            ErrorMessage = "Host name is required.";
            return [];
        }

        if (string.IsNullOrWhiteSpace(TargetResourceId))
        {
            ErrorMessage = "Target resource is required.";
            return [];
        }

        if (!GetTargetCandidates().Any(resource => string.Equals(resource.Id, TargetResourceId, StringComparison.OrdinalIgnoreCase)))
        {
            ErrorMessage = "Target resource must be in the selected group and expose endpoints.";
            return [];
        }

        if (!string.IsNullOrWhiteSpace(ProviderResourceId) &&
            !GetNamePublisherCandidates().Any(resource => string.Equals(resource.Id, ProviderResourceId, StringComparison.OrdinalIgnoreCase)))
        {
            ErrorMessage = "Publishing provider resource must be in the selected group and support name publishing.";
            return [];
        }

        return
        [
            new DnsNameMappingDefinition(
                CreateMappingId(HostName),
                HostName,
                HostName,
                TargetResourceId,
                GetTargetEndpointName(),
                GetExposure(),
                string.IsNullOrWhiteSpace(ProviderResourceId) ? null : ProviderResourceId)
        ];
    }

    private string? GetTargetEndpointName()
    {
        if (string.IsNullOrWhiteSpace(TargetEndpointName))
        {
            return null;
        }

        return GetTargetEndpoints(TargetResourceId)
            .Any(endpoint => string.Equals(endpoint.Name, TargetEndpointName, StringComparison.OrdinalIgnoreCase))
                ? TargetEndpointName
                : null;
    }

    private ResourceExposureScope GetExposure() =>
        Enum.TryParse<ResourceExposureScope>(SelectedExposure, out var exposure)
            ? exposure
            : ResourceExposureScope.Public;

    private bool IsCustomProviderSelected =>
        string.Equals(ProviderSelection, CustomProviderSelection, StringComparison.Ordinal);

    private bool IsLocalHostNameProviderSelected =>
        string.Equals(ProviderSelection, LocalHostNamesProvider, StringComparison.OrdinalIgnoreCase);

    private string? GetProvider() =>
        IsCustomProviderSelected
            ? NormalizeNullable(Provider)
            : NormalizeNullable(ProviderSelection);

    private string CreateMappingId(string hostName) =>
        $"{ResourceId.Trim()}:name:{CreateStableIdentifier(hostName)}";

    private static string? NormalizeNullable(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static bool ShouldWarnAboutLocalSuffix(string value)
    {
        var normalized = value.Trim().TrimEnd('.');
        return normalized.Equals("local", StringComparison.OrdinalIgnoreCase) ||
            normalized.EndsWith(".local", StringComparison.OrdinalIgnoreCase);
    }

    private static string CreateStableIdentifier(string value)
    {
        var normalized = new string(value
            .Trim()
            .ToLowerInvariant()
            .Select(character => char.IsLetterOrDigit(character) ? character : '-')
            .ToArray())
            .Trim('-');

        return string.IsNullOrWhiteSpace(normalized) ? "name" : normalized;
    }
}
