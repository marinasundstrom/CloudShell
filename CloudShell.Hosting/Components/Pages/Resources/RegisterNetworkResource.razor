@using System.Text.Json
@inject IResourceManager ResourceManager
@inject NavigationManager Navigation
@inject ICloudShellAuthorizationService Authorization

<ResourceRegistrationWizard TDraft="RegistrationDraft" @ref="Wizard" Steps="WizardSteps" @bind-Draft="Draft" Error="@ErrorMessage" OnCreate="Register" />

@code {
    private ResourceRegistrationWizard<RegistrationDraft> Wizard = default!;
    private RegistrationDraft Draft { get; set; } = new();
    private string? ValidateBasics() => string.IsNullOrWhiteSpace(ResourceId) ? "Name is required." : Draft.Group.Validate();
    private IReadOnlyList<ResourceRegistrationWizardStep> WizardSteps =>
    [
        new("Basics", Step0, ValidateBasics),
        new("Configuration", Step1, ValidateConfigurationStep),
        new("Review", Step2),
    ];
    private RenderFragment Step0 => @<FormPanel>
        <ResourceIdentityFields ResourceIdInputId="network-resource-id"
                                ResourceIdPlaceholder="app"
                                @bind-ResourceId="ResourceId" />
        <ResourceRegistrationGroupSelect Draft="Draft.Group" AllowNewGroup="@(Authorization.CanAccessResourceGroup("__new_resource_group", CloudShellPermissions.ResourceGroups.Create))" Id="network-group"
                             ResourceGroups="ResourceGroups"
                             @bind-Value="SelectedGroupId" />
    </FormPanel>;
    private RenderFragment Step1 => @<FormPanel>
        <FluentCheckbox @bind-Value="IsDefault">
            Default network
        </FluentCheckbox>

        <FluentCheckbox @bind-Value="CreateEndpointRequest">
            Endpoint request
        </FluentCheckbox>

        @if (CreateEndpointRequest)
        {
            <label for="network-endpoint-name">Endpoint name</label>
            <FluentTextField Id="network-endpoint-name" @bind-Value="EndpointName" />

            <EnumValueSelect TEnum="ResourceEndpointProtocol"
                             Id="network-endpoint-protocol"
                             Label="Protocol"
                             @bind-Value="SelectedProtocol" />

            <EndpointAssignmentEditor AssignmentId="network-endpoint-assignment"
                                      PortId="network-endpoint-port"
                                      ShowPortForAuto="true"
                                      Assignments="AllEndpointAssignments"
                                      @bind-Assignment="EndpointAssignment"
                                      @bind-Port="EndpointPort" />

            @if (RequiresHost)
            {
                <label for="network-endpoint-host">Host</label>
                <FluentTextField Id="network-endpoint-host" @bind-Value="EndpointHost" />

                <label for="network-endpoint-address">IP address</label>
                <FluentTextField Id="network-endpoint-address" @bind-Value="EndpointIPAddress" />
            }

            @if (IsPredefinedAssignment)
            {
                <label for="network-provider-endpoint">Provider endpoint</label>
                <FluentTextField Id="network-provider-endpoint" @bind-Value="ProviderEndpointId" />
            }

            <EnumValueSelect TEnum="ResourceExposureScope"
                             Id="network-endpoint-exposure"
                             Label="Exposure"
                             @bind-Value="SelectedExposure" />
        }
    </FormPanel>;
    private RenderFragment Step2 => @<FormPanel>
        <dl class="registration-review">
            <dt>Name</dt><dd>@ResourceId</dd>
            <dt>Resource group</dt><dd>@(Draft.Group.CreateNew ? $"New group: {Draft.Group.Name}" : ResourceGroups.FirstOrDefault(group => group.Id == SelectedGroupId)?.Name ?? Draft.Group.CreatedGroupName ?? "Default group")</dd>
            <dt>Endpoint name</dt><dd>@EndpointName</dd>
        </dl>
        <p class="muted">Review your choices before creating the resource. Use Back to make changes.</p>
    </FormPanel>;

    public sealed class RegistrationDraft
    {
        public ResourceRegistrationGroupDraft Group { get; set; } = new();
        public string ResourceId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public bool IsDefault { get; set; }
        public bool CreateEndpointRequest { get; set; }
        public string EndpointName { get; set; } = "network";
        public string EndpointHost { get; set; } = "localhost";
        public string EndpointIPAddress { get; set; } = string.Empty;
        public int? EndpointPort { get; set; }
        public string ProviderEndpointId { get; set; } = string.Empty;
        public string SelectedProtocol { get; set; } = ResourceEndpointProtocol.Http.ToString();
        public ResourceEndpointAssignment EndpointAssignment { get; set; } =
        ResourceEndpointAssignment.ProviderDefault;
        public string SelectedExposure { get; set; } = ResourceExposureScope.Local.ToString();
        public string SelectedGroupId { get; set; } = string.Empty;
    }

    private const string PlatformProviderId = "cloudshell.platform";
    private const string NetworkResourceType = "cloudshell.network";

    private string ResourceId { get => Draft.ResourceId; set => Draft.ResourceId = value; }
    private string Name { get => Draft.Name; set => Draft.Name = value; }
    private bool IsDefault { get => Draft.IsDefault; set => Draft.IsDefault = value; }
    private bool CreateEndpointRequest { get => Draft.CreateEndpointRequest; set => Draft.CreateEndpointRequest = value; }
    private string EndpointName { get => Draft.EndpointName; set => Draft.EndpointName = value; }
    private string EndpointHost { get => Draft.EndpointHost; set => Draft.EndpointHost = value; }
    private string EndpointIPAddress { get => Draft.EndpointIPAddress; set => Draft.EndpointIPAddress = value; }
    private int? EndpointPort { get => Draft.EndpointPort; set => Draft.EndpointPort = value; }
    private string ProviderEndpointId { get => Draft.ProviderEndpointId; set => Draft.ProviderEndpointId = value; }
    private string SelectedProtocol { get => Draft.SelectedProtocol; set => Draft.SelectedProtocol = value; }
    private ResourceEndpointAssignment EndpointAssignment { get => Draft.EndpointAssignment; set => Draft.EndpointAssignment = value; }
    private string SelectedExposure { get => Draft.SelectedExposure; set => Draft.SelectedExposure = value; }
    private string SelectedGroupId { get => Draft.SelectedGroupId; set => Draft.SelectedGroupId = value; }
    private string? ErrorMessage { get; set; }
    private IReadOnlyList<ResourceGroup> ResourceGroups { get; set; } = [];

    [CascadingParameter]
    public ResourceRegistrationNavigationContext? RegistrationNavigation { get; set; }

    private static readonly IReadOnlyList<ResourceEndpointAssignment> AllEndpointAssignments =
        Enum.GetValues<ResourceEndpointAssignment>();

    private bool IsPredefinedAssignment =>
        EndpointAssignment == ResourceEndpointAssignment.Predefined;

    private bool RequiresHost =>
        EndpointAssignment is ResourceEndpointAssignment.Manual or ResourceEndpointAssignment.Auto;

    protected override async Task OnInitializedAsync()
    {
        ResourceGroups = await ResourceManager.ListResourceGroupsAsync();
    }

    private string? ValidateConfigurationStep()
    {
        ErrorMessage = null;
        _ = BuildEndpointRequests();
        return ErrorMessage;
    }

    private async Task Register()
    {
        ErrorMessage = null;
        if (string.IsNullOrWhiteSpace(ResourceId))
        {
            ErrorMessage = "Name is required.";
            return;
        }

        var endpointRequests = BuildEndpointRequests();
        if (ErrorMessage is not null)
        {
            return;
        }

        var normalizedResourceId = ResourceNameNormalizer.Normalize(ResourceId, "network");
        var displayName = ResourceDisplayNameDefaults.Resolve(ResourceId);
        SelectedGroupId = await Draft.Group.ResolveAsync(SelectedGroupId,
            command => ResourceManager.CreateResourceGroupAsync(command)) ?? string.Empty;
        await ResourceManager.CreateResourceAsync(
            new CreateResourceCommand(
                PlatformProviderId,
                NetworkResourceType,
                normalizedResourceId,
                displayName,
                JsonSerializer.SerializeToElement(new NetworkResourceDefinition(
                    normalizedResourceId,
                    displayName,
                    IsDefault,
                    endpointRequests)),
                string.IsNullOrWhiteSpace(SelectedGroupId) ? null : SelectedGroupId));

        await Wizard.CompleteAsync();
        Navigation.NavigateTo(GetReturnUrl());
    }

    private string GetReturnUrl() =>
        RegistrationNavigation?.GetReturnUrlOrDefault() ??
        ResourceRegistrationNavigationContext.DefaultReturnUrl;

    private IReadOnlyList<ResourceEndpointRequest> BuildEndpointRequests()
    {
        if (!CreateEndpointRequest)
        {
            return [];
        }

        if (string.IsNullOrWhiteSpace(EndpointName))
        {
            ErrorMessage = "Endpoint name is required.";
            return [];
        }

        var assignment = EndpointAssignment;
        if (assignment == ResourceEndpointAssignment.Manual &&
            EndpointPort is null)
        {
            ErrorMessage = "Manual endpoints require a port.";
            return [];
        }

        if (assignment == ResourceEndpointAssignment.Predefined &&
            string.IsNullOrWhiteSpace(ProviderEndpointId))
        {
            ErrorMessage = "Provider endpoint is required.";
            return [];
        }

        return
        [
            new ResourceEndpointRequest(
                EndpointName,
                GetEndpointProtocol(),
                Host: string.IsNullOrWhiteSpace(EndpointHost) ? null : EndpointHost,
                Port: EndpointPort,
                IPAddress: string.IsNullOrWhiteSpace(EndpointIPAddress) ? null : EndpointIPAddress,
                Exposure: GetExposure(),
                Assignment: assignment,
                ProviderEndpointId: string.IsNullOrWhiteSpace(ProviderEndpointId) ? null : ProviderEndpointId)
        ];
    }

    private ResourceEndpointProtocol GetEndpointProtocol() =>
        Enum.TryParse<ResourceEndpointProtocol>(SelectedProtocol, out var protocol)
            ? protocol
            : ResourceEndpointProtocol.Http;

    private ResourceExposureScope GetExposure() =>
        Enum.TryParse<ResourceExposureScope>(SelectedExposure, out var exposure)
            ? exposure
            : ResourceExposureScope.Local;
}
