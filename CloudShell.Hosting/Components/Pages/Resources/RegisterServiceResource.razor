@using System.Text.Json
@inject IResourceManager ResourceManager
@inject NavigationManager Navigation
@inject ICloudShellAuthorizationService Authorization

<ResourceRegistrationWizard TDraft="RegistrationDraft" @ref="Wizard" Steps="WizardSteps" @bind-Draft="Draft" Error="@ErrorMessage" OnCreate="Register" />

@code {
    private ResourceRegistrationWizard<RegistrationDraft> Wizard = default!;
    private RegistrationDraft Draft { get; set; } = new();
    private string? ValidateBasics() => string.IsNullOrWhiteSpace(ResourceId) ? "Name is required." : Draft.Group.Validate();
    private IReadOnlyList<ResourceRegistrationWizardStep> WizardSteps =>
    [
        new("Basics", Step0, ValidateBasics),
        new("Targets", Step1, () => SelectedTargetIds.Count == 0 ? "Select at least one target resource." : null),
        new("Endpoints", Step2, () => string.IsNullOrWhiteSpace(PortName) || TargetPort <= 0 ? "Port name and target port are required." : IsManualAssignment && Port is null ? "Manual endpoint assignment requires an exposed port." : null),
        new("Review", Step3),
    ];
    private RenderFragment Step0 => @<FormPanel>
        <ResourceIdentityFields ResourceIdInputId="service-resource-id"
                                ResourceIdPlaceholder="api"
                                @bind-ResourceId="ResourceId" />
        <ResourceRegistrationGroupSelect Draft="Draft.Group" AllowNewGroup="@(Authorization.CanAccessResourceGroup("__new_resource_group", CloudShellPermissions.ResourceGroups.Create))" Id="service-group"
                             ResourceGroups="ResourceGroups"
                             @bind-Value="SelectedGroupId" />
    </FormPanel>;
    private RenderFragment Step1 => @<FormPanel>
        <p class="muted">
            Use a Service when you need an explicit service unit or facade over target resources.
            Container apps can expose app-owned endpoints without a Service resource.
        </p>



        <ResourceSelectionSection Title="Targets"
                                  Resources="GetTargetCandidates()"
                                  SelectedResourceIds="SelectedTargetIds" />

        <ResourceSelectionSection Title="Networks"
                                  Resources="GetNetworkCandidates()"
                                  SelectedResourceIds="SelectedNetworkIds" />
    </FormPanel>;
    private RenderFragment Step2 => @<FormPanel>
        <label for="service-port-name">Port name</label>
        <FluentTextField Id="service-port-name" @bind-Value="PortName" />

        <label for="service-target-port">Target port</label>
        <FluentNumberField TValue="int" Id="service-target-port" Min="1" @bind-Value="TargetPort" />

        <EndpointAssignmentEditor AssignmentId="service-port-assignment"
                                  PortId="service-port"
                                  PortLabel="Exposed port"
                                  @bind-Assignment="EndpointAssignment"
                                  @bind-Port="Port" />

        <label for="service-protocol">Protocol</label>
        <FluentSelect TOption="string"
                      Id="service-protocol"
                      @bind-Value="Protocol"
                      Appearance="Appearance.Outline">
            <FluentOption TOption="string" Value="tcp">TCP</FluentOption>
            <FluentOption TOption="string" Value="udp">UDP</FluentOption>
            <FluentOption TOption="string" Value="http">HTTP</FluentOption>
            <FluentOption TOption="string" Value="https">HTTPS</FluentOption>
        </FluentSelect>

        <EnumValueSelect TEnum="ResourceExposureScope"
                         Id="service-exposure"
                         Label="Exposure"
                         @bind-Value="SelectedExposure" />
    </FormPanel>;
    private RenderFragment Step3 => @<FormPanel>
        <dl class="registration-review">
            <dt>Name</dt><dd>@ResourceId</dd>
            <dt>Resource group</dt><dd>@(Draft.Group.CreateNew ? $"New group: {Draft.Group.Name}" : ResourceGroups.FirstOrDefault(group => group.Id == SelectedGroupId)?.Name ?? Draft.Group.CreatedGroupName ?? "Default group")</dd>
            <dt>Port name</dt><dd>@PortName</dd>
            <dt>Target port</dt><dd>@TargetPort</dd>
        </dl>
        <p class="muted">Review your choices before creating the resource. Use Back to make changes.</p>
    </FormPanel>;

    public sealed class RegistrationDraft
    {
        public ResourceRegistrationGroupDraft Group { get; set; } = new();
        public string ResourceId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string SelectedGroupId { get; set; } = string.Empty;
        public string PortName { get; set; } = "http";
        public int TargetPort { get; set; } = 80;
        public int? Port { get; set; }
        public string Protocol { get; set; } = "tcp";
        public ResourceEndpointAssignment EndpointAssignment { get; set; } = ResourceEndpointAssignment.Auto;
        public string SelectedExposure { get; set; } = ResourceExposureScope.Local.ToString();
        public HashSet<string> SelectedTargetIds { get; set; } = new(StringComparer.OrdinalIgnoreCase);
        public HashSet<string> SelectedNetworkIds { get; set; } = new(StringComparer.OrdinalIgnoreCase);
    }

    private const string PlatformProviderId = "cloudshell.platform";
    private const string NetworkResourceType = "cloudshell.network";
    private const string ServiceResourceType = "cloudshell.service";

    private string ResourceId { get => Draft.ResourceId; set => Draft.ResourceId = value; }
    private string Name { get => Draft.Name; set => Draft.Name = value; }
    private string SelectedGroupId { get => Draft.SelectedGroupId; set => Draft.SelectedGroupId = value; }
    private HashSet<string> SelectedTargetIds => Draft.SelectedTargetIds;
    private HashSet<string> SelectedNetworkIds => Draft.SelectedNetworkIds;
    private string PortName { get => Draft.PortName; set => Draft.PortName = value; }
    private int TargetPort { get => Draft.TargetPort; set => Draft.TargetPort = value; }
    private int? Port { get => Draft.Port; set => Draft.Port = value; }
    private string Protocol { get => Draft.Protocol; set => Draft.Protocol = value; }
    private ResourceEndpointAssignment EndpointAssignment { get => Draft.EndpointAssignment; set => Draft.EndpointAssignment = value; }
    private string SelectedExposure { get => Draft.SelectedExposure; set => Draft.SelectedExposure = value; }
    private string? ErrorMessage { get; set; }
    private IReadOnlyList<ResourceGroup> ResourceGroups { get; set; } = [];
    private IReadOnlyList<Resource> Resources { get; set; } = [];
    private IReadOnlyDictionary<string, ResourceGroup> ResourceGroupsByResourceId { get; set; } =
        ResourceManagerUiAccess.EmptyGroupLookup;

    [CascadingParameter]
    public ResourceRegistrationNavigationContext? RegistrationNavigation { get; set; }

    private bool IsManualAssignment =>
        EndpointAssignment == ResourceEndpointAssignment.Manual;

    protected override async Task OnInitializedAsync()
    {
        ResourceGroups = await ResourceManager.ListResourceGroupsAsync();
        Resources = await ResourceManager.ListResourcesAsync();
        ResourceGroupsByResourceId = await ResourceManagerUiAccess.CreateGroupLookupAsync(
            ResourceManager,
            Resources);
    }

    private IReadOnlyList<Resource> GetTargetCandidates() =>
        Resources
            .Where(resource => !string.Equals(resource.EffectiveTypeId, ServiceResourceType, StringComparison.OrdinalIgnoreCase))
            .Where(resource => !string.Equals(resource.EffectiveTypeId, NetworkResourceType, StringComparison.OrdinalIgnoreCase))
            .Where(IsInSelectedGroup)
            .OrderBy(ResourceDisplayLabels.GetLabel, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private IReadOnlyList<Resource> GetNetworkCandidates() =>
        Resources
            .Where(resource => string.Equals(resource.EffectiveTypeId, NetworkResourceType, StringComparison.OrdinalIgnoreCase))
            .Where(IsInSelectedGroup)
            .OrderBy(ResourceDisplayLabels.GetLabel, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private bool IsInSelectedGroup(Resource resource)
    {
        var group = ResourceManagerUiAccess.GetResourceGroup(ResourceGroupsByResourceId, resource.Id);
        return string.IsNullOrWhiteSpace(SelectedGroupId)
            ? group is null
            : string.Equals(group?.Id, SelectedGroupId, StringComparison.OrdinalIgnoreCase);
    }

    private async Task Register()
    {
        ErrorMessage = null;
        if (string.IsNullOrWhiteSpace(ResourceId))
        {
            ErrorMessage = "Name is required.";
            return;
        }

        if (SelectedTargetIds.Count == 0)
        {
            ErrorMessage = "Select at least one target resource.";
            return;
        }

        if (string.IsNullOrWhiteSpace(PortName) || TargetPort <= 0)
        {
            ErrorMessage = "Port name and target port are required.";
            return;
        }

        if (IsManualAssignment && Port is null)
        {
            ErrorMessage = "Manual endpoint assignment requires an exposed port.";
            return;
        }

        var exposure = Enum.TryParse<ResourceExposureScope>(SelectedExposure, out var parsedExposure)
            ? parsedExposure
            : ResourceExposureScope.Network;
        var assignedPort = IsManualAssignment ? Port : null;
        var normalizedResourceId = ResourceNameNormalizer.Normalize(ResourceId, "service");
        var displayName = ResourceDisplayNameDefaults.Resolve(ResourceId);

        var definition = new ServiceResourceDefinition(
            normalizedResourceId,
            displayName,
            SelectedTargetIds.Select(resourceId => new ServiceTarget(resourceId)).ToArray(),
            [new ServicePort(PortName, TargetPort, assignedPort, Protocol, exposure)],
            SelectedNetworkIds.ToArray());

        SelectedGroupId = await Draft.Group.ResolveAsync(SelectedGroupId,
            command => ResourceManager.CreateResourceGroupAsync(command)) ?? string.Empty;
        await ResourceManager.CreateResourceAsync(
            new CreateResourceCommand(
                PlatformProviderId,
                ServiceResourceType,
                normalizedResourceId,
                displayName,
                JsonSerializer.SerializeToElement(definition),
                string.IsNullOrWhiteSpace(SelectedGroupId) ? null : SelectedGroupId));

        await Wizard.CompleteAsync();
        Navigation.NavigateTo(GetReturnUrl());
    }

    private string GetReturnUrl() =>
        RegistrationNavigation?.GetReturnUrlOrDefault() ??
        ResourceRegistrationNavigationContext.DefaultReturnUrl;

}
