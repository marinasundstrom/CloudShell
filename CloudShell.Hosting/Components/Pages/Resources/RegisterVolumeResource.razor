@using System.Text.Json
@inject IResourceManager ResourceManager
@inject NavigationManager Navigation
@inject ICloudShellAuthorizationService Authorization
@inject ICoreShellRouteService ShellRoutes
@inject IStringLocalizer<SharedResource> L

<ResourceRegistrationWizard TDraft="RegistrationDraft" @ref="Wizard" Steps="WizardSteps" @bind-Draft="Draft" Error="@ErrorMessage" OnCreate="Register" />

@code {
    private ResourceRegistrationWizard<RegistrationDraft> Wizard = default!;
    private RegistrationDraft Draft { get; set; } = new();
    private string? ValidateBasics() => string.IsNullOrWhiteSpace(ResourceId) ? "Name is required." : Draft.Group.Validate();
    private IReadOnlyList<ResourceRegistrationWizardStep> WizardSteps =>
    [
        new("Basics", Step0, ValidateBasics),
        new("Configuration", Step1, () => HasSelectedStorage && string.IsNullOrWhiteSpace(Location) ? "Storage-owned volumes require a subpath." : null),
        new("Review", Step2),
    ];
    private RenderFragment Step0 => @<FormPanel>
        <ResourceIdentityFields ResourceIdInputId="volume-resource-id"
                                ResourceIdPlaceholder="data"
                                @bind-ResourceId="ResourceId" />
        <ResourceRegistrationGroupSelect Draft="Draft.Group" Disabled="@HasSelectedStorage" AllowNewGroup="@(!HasSelectedStorage && Authorization.CanAccessResourceGroup("__new_resource_group", CloudShellPermissions.ResourceGroups.Create))" Id="volume-group"
                             ResourceGroups="ResourceGroups"
                             @bind-Value="SelectedGroupId" />
    </FormPanel>;
    private RenderFragment Step1 => @<FormPanel>
        <label for="volume-provider">Provider</label>
        <FluentTextField Id="volume-provider"
                         Disabled="@HasSelectedStorage"
                         Value="@(HasSelectedStorage ? GetSelectedStorageProvider() : Provider)"
                         ValueChanged="@(value => Provider = value ?? string.Empty)"
                         Placeholder="Local Storage" />

        <label for="volume-storage">Storage resource</label>
        <FluentSelect TOption="string"
                      Id="volume-storage"
                      Value="@SelectedStorageResourceId"
                      ValueChanged="ChangeSelectedStorageResource"
                      Appearance="Appearance.Outline">
            <FluentOption TOption="string" Value="">Direct filesystem path</FluentOption>
            @foreach (var storage in StorageResources)
            {
                <FluentOption TOption="string" Value="@storage.Id">@ResourceDisplayLabels.GetQualifiedLabel(storage)</FluentOption>
            }
        </FluentSelect>

        <label for="volume-location">Volume path</label>
        <FluentTextField Id="volume-location"
                         @bind-Value="Location"
                         Placeholder="@GetLocationPlaceholder()" />

        <EnumValueSelect TEnum="VolumeAccessMode"
                         Id="volume-access-mode"
                         Label="Access mode"
                         LabelSelector="GetAccessModeLabel"
                         @bind-Value="SelectedAccessMode" />

        <FluentCheckbox @bind-Value="Persistent">
            Persistent
        </FluentCheckbox>

        <label for="volume-max-size">Max size bytes</label>
        <FluentNumberField TValue="long?"
                           Id="volume-max-size"
                           Min="1"
                           @bind-Value="MaxSizeBytes" />
    </FormPanel>;
    private RenderFragment Step2 => @<FormPanel>
        <dl class="registration-review">
            <dt>Name</dt><dd>@ResourceId</dd>
            <dt>Resource group</dt><dd>@(Draft.Group.CreateNew ? $"New group: {Draft.Group.Name}" : ResourceGroups.FirstOrDefault(group => group.Id == SelectedGroupId)?.Name ?? Draft.Group.CreatedGroupName ?? "Default group")</dd>
            <dt>Location</dt><dd>@(string.IsNullOrWhiteSpace(Location) ? "Provider-managed location" : Location)</dd>
            <dt>Provider</dt><dd>@(HasSelectedStorage ? GetSelectedStorageProvider() : NormalizeNullable(Provider) ?? StorageProviderNames.LocalStorage)</dd>
            <dt>Access mode</dt><dd>@GetAccessModeLabel(ParseAccessMode())</dd>
            <dt>Persistent</dt><dd>@(Persistent ? "Yes" : "No")</dd>
        </dl>
        <p class="muted">Review your choices before creating the resource. Use Back to make changes.</p>
    </FormPanel>;

    public sealed class RegistrationDraft
    {
        public ResourceRegistrationGroupDraft Group { get; set; } = new();
        public string ResourceId { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string SelectedGroupId { get; set; } = string.Empty;
        public string SelectedStorageResourceId { get; set; } = string.Empty;
        public string Provider { get; set; } = string.Empty;
        public string Location { get; set; } = string.Empty;
        public string SelectedAccessMode { get; set; } = VolumeAccessMode.ReadWriteOnce.ToString();
        public bool Persistent { get; set; } = true;
        public long? MaxSizeBytes { get; set; }
    }

    private const string PlatformProviderId = "cloudshell.platform";
    private const string VolumeResourceType = "cloudshell.volume";
    private const string StorageResourceQueryParameter = "storageResourceId";

    private string ResourceId { get => Draft.ResourceId; set => Draft.ResourceId = value; }
    private string Name { get => Draft.Name; set => Draft.Name = value; }
    private string SelectedGroupId { get => Draft.SelectedGroupId; set => Draft.SelectedGroupId = value; }
    private string SelectedStorageResourceId { get => Draft.SelectedStorageResourceId; set => Draft.SelectedStorageResourceId = value; }
    private string Provider { get => Draft.Provider; set => Draft.Provider = value; }
    private string Location { get => Draft.Location; set => Draft.Location = value; }
    private string SelectedAccessMode { get => Draft.SelectedAccessMode; set => Draft.SelectedAccessMode = value; }
    private bool Persistent { get => Draft.Persistent; set => Draft.Persistent = value; }
    private long? MaxSizeBytes { get => Draft.MaxSizeBytes; set => Draft.MaxSizeBytes = value; }
    private string? ErrorMessage { get; set; }
    private IReadOnlyList<ResourceGroup> ResourceGroups { get; set; } = [];
    private IReadOnlyList<Resource> StorageResources { get; set; } = [];
    private IReadOnlyDictionary<string, ResourceGroup> StorageGroupsByResourceId { get; set; } =
        ResourceManagerUiAccess.EmptyGroupLookup;

    [CascadingParameter]
    public ResourceRegistrationNavigationContext? RegistrationNavigation { get; set; }

    private bool HasSelectedStorage =>
        !string.IsNullOrWhiteSpace(SelectedStorageResourceId);

    protected override async Task OnInitializedAsync()
    {
        ResourceGroups = await ResourceManager.ListResourceGroupsAsync();
        StorageGroupsByResourceId = ResourceManagerUiAccess.CreateGroupLookup(ResourceGroups);
        StorageResources = (await ResourceManager.ListResourcesAsync())
            .Where(resource => resource.HasCapability(ResourceCapabilityIds.StorageProvider))
            .OrderBy(ResourceDisplayLabels.GetQualifiedLabel, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        SelectedStorageResourceId = GetRequestedStorageResourceId() ?? string.Empty;
        ApplySelectedStorageGroup();
    }

    private async Task Register()
    {
        ErrorMessage = null;
        if (string.IsNullOrWhiteSpace(ResourceId))
        {
            ErrorMessage = "Name is required.";
            return;
        }

        if (HasSelectedStorage && string.IsNullOrWhiteSpace(Location))
        {
            ErrorMessage = "Storage-owned volumes require a subpath.";
            return;
        }

        if (HasSelectedStorage && !CanManageSelectedStorage())
        {
            ErrorMessage = "You need manage permission on the selected Storage resource to create an owned volume.";
            return;
        }

        var normalizedResourceId = ResourceNameNormalizer.Normalize(ResourceId, "volume");
        var displayName = ResourceDisplayNameDefaults.Resolve(ResourceId);
        var definition = new VolumeResourceDefinition(
            normalizedResourceId,
            displayName,
            HasSelectedStorage ? GetSelectedStorageProvider() : NormalizeNullable(Provider),
            HasSelectedStorage ? null : NormalizeNullable(Location),
            Persistent,
            ParseAccessMode(),
            NormalizeNullable(SelectedStorageResourceId),
            HasSelectedStorage ? NormalizeNullable(Location) : null,
            MaxSizeBytes is > 0 ? MaxSizeBytes : null);

        SelectedGroupId = await Draft.Group.ResolveAsync(SelectedGroupId,
            command => ResourceManager.CreateResourceGroupAsync(command)) ?? string.Empty;
        await ResourceManager.CreateResourceAsync(
            new CreateResourceCommand(
                PlatformProviderId,
                VolumeResourceType,
                normalizedResourceId,
                displayName,
                JsonSerializer.SerializeToElement(definition),
                string.IsNullOrWhiteSpace(SelectedGroupId) ? null : SelectedGroupId,
                ResourceClass.Storage));

        var explicitReturnUrl = GetExplicitReturnUrl();
        await Wizard.CompleteAsync();
        Navigation.NavigateTo(explicitReturnUrl ??
            (HasSelectedStorage
            ? BuildStorageVolumesRoute(SelectedStorageResourceId)
            : GetReturnUrl()));
    }

    private string GetReturnUrl() =>
        RegistrationNavigation?.GetReturnUrlOrDefault() ??
        ResourceRegistrationNavigationContext.DefaultReturnUrl;

    private string? GetExplicitReturnUrl()
    {
        var returnUrl = RegistrationNavigation?.ReturnUrl;
        return ResourceRegistrationNavigationContext.IsLocalReturnUrl(returnUrl)
            ? returnUrl!.Trim()
            : null;
    }

    private VolumeAccessMode ParseAccessMode() =>
        Enum.TryParse<VolumeAccessMode>(SelectedAccessMode, out var mode)
            ? mode
            : VolumeAccessMode.ReadWriteOnce;

    private static string? NormalizeNullable(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private string? GetRequestedStorageResourceId()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (!query.TryGetValue(StorageResourceQueryParameter, out var values))
        {
            return null;
        }

        var requested = values.ToString();
        return string.IsNullOrWhiteSpace(requested) ||
            !StorageResources.Any(resource => string.Equals(resource.Id, requested, StringComparison.OrdinalIgnoreCase))
                ? null
                : requested;
    }

    private string? GetSelectedStorageProvider() =>
        StorageResources
            .FirstOrDefault(resource => string.Equals(resource.Id, SelectedStorageResourceId, StringComparison.OrdinalIgnoreCase))
            ?.ResourceAttributes.GetValueOrDefault(ResourceAttributeNames.StorageProvider) ??
        StorageProviderNames.LocalStorage;

    private bool CanManageSelectedStorage() =>
        StorageResources
            .FirstOrDefault(resource => string.Equals(resource.Id, SelectedStorageResourceId, StringComparison.OrdinalIgnoreCase)) is { } storage &&
        ResourceManagerUiAccess.CanManageResource(Authorization, storage, StorageGroupsByResourceId);

    private void ChangeSelectedStorageResource(string? storageResourceId)
    {
        SelectedStorageResourceId = storageResourceId ?? string.Empty;
        ApplySelectedStorageGroup();
    }

    private void ApplySelectedStorageGroup()
    {
        if (string.IsNullOrWhiteSpace(SelectedStorageResourceId))
        {
            return;
        }

        Draft.Group.CreateNew = false;
        SelectedGroupId = ResourceManagerUiAccess.GetResourceGroupId(
            StorageGroupsByResourceId,
            SelectedStorageResourceId) ?? string.Empty;
    }

    private string BuildStorageVolumesRoute(string resourceId) =>
        ResourceManagerShellLinks.ResourceDetails(ShellRoutes, resourceId, ResourcePredefinedViewIds.Volumes);

    private string GetLocationPlaceholder() =>
        HasSelectedStorage ? "postgres-data" : "./data/postgres or /mnt/share/postgres";

    private string GetAccessModeLabel(VolumeAccessMode mode) =>
        ResourceVolumeDisplay.GetAccessModeLabel(mode, Localize);

    private string Localize(string value) => L[value].Value;

}
