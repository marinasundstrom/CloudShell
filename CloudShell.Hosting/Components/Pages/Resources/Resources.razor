@page "/resources"
@page "/resources/{ResourceId}"
@page "/resources/{ResourceId}/dashboard"
@page "/resources/{ResourceId}/logs"
@page "/resources/{ResourceId}/traces"
@page "/resources/{ResourceId}/metrics"
@layout CloudShell.Hosting.Components.Operations.OperationsLayout
@rendermode InteractiveServer
@using CloudShell.Hosting.Components.Operations
@using CloudShell.Hosting.Components.Pages.Logs
@using CloudShell.Hosting.Components.Pages.Observability
@inject ICloudShellAuthorizationService Authorization
@inject NavigationManager Navigation

<PageTitle>Resources</PageTitle>
@if (ActiveOperation == "logs")
{
    @if (Authorization.CanReadLogs()) { <LogExplorer ResourceId="@(ResourceId ?? QueryResourceId)" LogSourceId="@LogSourceId" TraceId="@TraceId" View="@LogView" SourceIds="@SourceIds" ShowHeading="false" /> }
    else { <EmptyState Title="Access denied" Message="Your identity cannot read logs." /> }
}
else if (ActiveOperation == "traces")
{
    @if (Authorization.CanReadTraces()) { <TraceExplorer ResourceId="@(ResourceId ?? QueryResourceId)" TraceId="@TraceId" ScopeResourceId="@ScopeResourceId" ShowHeading="false" /> }
    else { <EmptyState Title="Access denied" Message="Your identity cannot read traces." /> }
}
else if (ActiveOperation == "metrics")
{
    @if (Authorization.CanReadMetrics()) { <MetricExplorer ResourceId="@(ResourceId ?? QueryResourceId)" ScopeResourceId="@ScopeResourceId" View="@LogView" ShowHeading="false" /> }
    else { <EmptyState Title="Access denied" Message="Your identity cannot read metrics." /> }
}
else { <OperationsDashboard /> }

@code {
    [CascadingParameter] public OperationsWorkspaceContext? Workspace { get; set; }
    private string ActiveOperation => Workspace?.Pane ?? Operation ?? OperationsNavigation.Parse(Navigation.ToBaseRelativePath(Navigation.Uri)).Pane;
    [Parameter] public string? ResourceId { get; set; }
    [SupplyParameterFromQuery(Name = "resourceId")] public string? QueryResourceId { get; set; }
    [SupplyParameterFromQuery(Name = "operation")] public string? Operation { get; set; }
    [SupplyParameterFromQuery(Name = "logSourceId")] public string? LogSourceId { get; set; }
    [SupplyParameterFromQuery(Name = "traceId")] public string? TraceId { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? LogView { get; set; }
    [SupplyParameterFromQuery(Name = "sourceIds")] public string? SourceIds { get; set; }
    [SupplyParameterFromQuery(Name = "scopeResourceId")] public string? ScopeResourceId { get; set; }
}
