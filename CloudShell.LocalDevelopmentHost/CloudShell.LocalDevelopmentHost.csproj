<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <CloudShellBuiltInServiceRuntime Condition="'$(CloudShellBuiltInServiceRuntime)' == ''">Process</CloudShellBuiltInServiceRuntime>
    <DefineConstants Condition="'$(CloudShellBuiltInServiceRuntime)' == 'Container'">$(DefineConstants);CLOUDSHELL_BUILTIN_SERVICES_CONTAINER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CloudShell.AppHost\CloudShell.AppHost.csproj" />
    <ProjectReference Include="..\CloudShell.ControlPlane.Providers.UI\CloudShell.ControlPlane.Providers.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Data/**" />
    <None Remove="Data/**" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CloudShell.ConfigurationStoreImage"
                      Value="$(CloudShellConfigurationStoreImage)"
                      Condition="'$(CloudShellConfigurationStoreImage)' != ''" />
    <AssemblyMetadata Include="CloudShell.SecretsVaultImage"
                      Value="$(CloudShellSecretsVaultImage)"
                      Condition="'$(CloudShellSecretsVaultImage)' != ''" />
    <AssemblyMetadata Include="CloudShell.DeviceRegistryImage"
                      Value="$(CloudShellDeviceRegistryImage)"
                      Condition="'$(CloudShellDeviceRegistryImage)' != ''" />
  </ItemGroup>

  <Target Name="ValidateBuiltInServiceRuntime" BeforeTargets="CoreCompile">
    <Error Condition="'$(CloudShellBuiltInServiceRuntime)' != 'Process' and '$(CloudShellBuiltInServiceRuntime)' != 'Container'"
           Text="CloudShellBuiltInServiceRuntime must be Process or Container." />
  </Target>

</Project>
